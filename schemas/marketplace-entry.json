{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Marketplace Entry",
  "description": "Schema for individual plugin entries in marketplace.json plugins array",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Lowercase hyphenated plugin slug - must match plugin.json name"
    },
    "description": {
      "type": "string",
      "maxLength": 120,
      "description": "One-sentence plugin description"
    },
    "source": {
      "description": "Plugin source. For monorepo plugins (in same repo as marketplace.json), use a relative-path string starting with './'. For external GitHub repos, use the object form.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\./plugins/[a-z][a-z0-9-]*$",
          "description": "Relative path from repo root - preferred for monorepo plugins"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["github", "url", "git-subdir", "npm"]
            },
            "repo": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+$"
            },
            "url": { "type": "string" },
            "package": { "type": "string" },
            "path": {
              "type": "string",
              "pattern": "^plugins/[a-z][a-z0-9-]*$"
            }
          },
          "required": ["type"],
          "additionalProperties": false
        }
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version - must match plugin.json version"
    }
  },
  "required": ["name", "description", "source", "version"],
  "additionalProperties": false
}
