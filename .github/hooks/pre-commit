#!/usr/bin/env bash
# Pre-commit hook - lints staged YAML and Markdown files before commit.
# Setup: mise run setup

set -euo pipefail

# Block direct commits to main - all phase work must happen on a feature branch.
CURRENT_BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --abbrev-ref HEAD)"
if [[ "$CURRENT_BRANCH" == "main" ]]; then
  echo ""
  echo "ERROR: Direct commits to 'main' are not allowed."
  echo "Create a phase branch first: git checkout -b gsd/<slug>"
  echo "See CLAUDE.md section GSD Workflow for branch naming conventions."
  echo ""
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
# Use empty-tree SHA as base when no commits exist yet (initial commit).
if git rev-parse --verify HEAD >/dev/null 2>&1; then
  STAGED=$(git diff --cached --name-only --diff-filter=ACM)
else
  STAGED=$(git diff --cached --name-only --diff-filter=ACM 4b825dc642cb6eb9a060e54bf8d69288fbee4904)
fi

YAML_FILES=$(echo "$STAGED" | grep -E '\.(yml|yaml)$' || true)
# Exclude .planning/ from markdownlint - planning docs are not plugin content
MD_FILES=$(echo "$STAGED" | grep -E '\.md$' | grep -v '^\.planning/' || true)

ERRORS=0

if [[ -n "$YAML_FILES" ]]; then
  if ! command -v yamllint &>/dev/null; then
    echo "SKIP: yamllint not found - run: mise run setup"
  else
    echo "yamllint: checking staged YAML files..."
    while IFS= read -r f; do
      if ! yamllint -c "$REPO_ROOT/.yamllint.yml" "$REPO_ROOT/$f"; then
        ERRORS=1
      fi
    done <<< "$YAML_FILES"
  fi
fi

if [[ -n "$MD_FILES" ]]; then
  if ! command -v markdownlint &>/dev/null; then
    echo "SKIP: markdownlint not found - run: mise run setup"
  else
    echo "markdownlint: checking staged Markdown files..."
    while IFS= read -r f; do
      if ! markdownlint --config "$REPO_ROOT/.markdownlint.json" "$REPO_ROOT/$f"; then
        ERRORS=1
      fi
    done <<< "$MD_FILES"
  fi
fi

SH_FILES=$(echo "$STAGED" | grep -E '\.sh$' || true)

if [[ -n "$SH_FILES" ]]; then
  if ! command -v shellcheck &>/dev/null; then
    echo "SKIP: shellcheck not found - run: mise run setup"
  else
    echo "shellcheck: checking staged shell scripts..."
    while IFS= read -r f; do
      if ! shellcheck "$REPO_ROOT/$f"; then
        ERRORS=1
      fi
    done <<< "$SH_FILES"
  fi
fi

# Prettier auto-format - writes staged Markdown/JSON/YAML files in place and re-stages them.
# Runs --write (not --check) so the commit always includes formatted content.
PRETTIER_FILES=$(echo "$STAGED" | grep -E '\.(md|json|yml|yaml)$' || true)

if [[ -n "$PRETTIER_FILES" ]]; then
  if ! command -v npx &>/dev/null; then
    echo "SKIP: npx not found - install Node.js"
  else
    echo "prettier: formatting staged Markdown/JSON/YAML files..."
    cd "$REPO_ROOT" && echo "$PRETTIER_FILES" | tr '\n' '\0' | xargs -0 npx prettier@3.8.3 --write --ignore-path .prettierignore 2>&1
    # Re-stage formatted files so the commit includes the formatted versions.
    echo "$PRETTIER_FILES" | tr '\n' '\0' | xargs -0 git add
  fi
fi

# Naming convention checks - the same script CI runs (validate.yml, step "Check plugin and skill naming").
# Runs only when plugin dirs, the marketplace registry, or the naming config are staged.
PLUGIN_STAGED=$(echo "$STAGED" | grep -E '^(plugins/|\.claude-plugin/|\.engagement\.json$)' || true)

if [[ -n "$PLUGIN_STAGED" ]]; then
  echo "naming: checking plugin and skill names against .engagement.json..."
  # The assignment must not fail under set -e before the reason is printed, so capture the exit code.
  NAMING_RC=0
  NAMING_OUTPUT=$(cd "$REPO_ROOT" && python3 scripts/check-naming.py) || NAMING_RC=$?
  echo "$NAMING_OUTPUT"
  if [[ $NAMING_RC -ne 0 ]]; then
    echo ""
    echo "Fix naming violations before committing. See .claude/docs/naming-convention.md."
    ERRORS=1
  fi
fi

# NOTE: claude plugin validate is intentionally omitted here. The CI validate-plugin-cli
# job uses the reusable action with warn-invariants="I1 I3 I8 I11", which cannot be
# replicated via the CLI directly. CI is the authoritative gate for schema correctness.

if [[ "$ERRORS" -ne 0 ]]; then
  echo ""
  echo "Pre-commit lint failed. Fix the errors above and re-stage the files."
  exit 1
fi
